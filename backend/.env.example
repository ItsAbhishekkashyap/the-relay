# ==============================================================================
# The Relay — Backend Environment Variables (for Render & Local Development)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODEL PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Active model provider: 'groq' (for live cloud inference) or 'simulator' (for zero-cost testing)
MODEL_PROVIDER=groq

# ------------------------------------------------------------------------------
# 2. GROQ CLOUD CONFIGURATION (Required when MODEL_PROVIDER=groq)
# ------------------------------------------------------------------------------
# Your Groq API key from https://console.groq.com/keys
# Example: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=your_actual_groq_api_key_here

# Groq model identifier (characterized model)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. CORS CONFIGURATION (Crucial for Vercel Frontend Connection)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins, or '*' for open access
# Example for production: https://the-relay-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK (Render injects PORT automatically)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 5. SIMULATOR SETTINGS (Used when MODEL_PROVIDER=simulator)
# ------------------------------------------------------------------------------
# In unified single-service deployment, the simulator is mounted at /simulator
SIMULATOR_BASE_URL=http://127.0.0.1:8000/simulator
SIMULATOR_MODEL=simulator/mock-model-v1
SIMULATOR_TIMEOUT=30.0
