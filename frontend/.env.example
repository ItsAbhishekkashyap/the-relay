# ==============================================================================
# The Relay — Frontend Environment Variables (for Vercel & Local Development)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API CONNECTION (Required for Vercel Deployment)
# ------------------------------------------------------------------------------
# Set this to the public URL of your deployed Render backend web service.
# DO NOT include a trailing slash.
# Example: https://the-relay-backend.onrender.com
# For local development with Vite proxy, leave this blank.
VITE_API_BASE_URL=https://the-relay-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. CLIENT TIMEOUT & POLLING SETTINGS (Optional - defaults shown)
# ------------------------------------------------------------------------------
# Health check / status probe timeout in milliseconds
VITE_REQUEST_TIMEOUT_MS=10000

# Research question answering workflow timeout in milliseconds (60s default)
VITE_ASK_TIMEOUT_MS=60000

# Live monitoring poll interval in milliseconds (15s default)
VITE_POLL_INTERVAL_MS=15000
