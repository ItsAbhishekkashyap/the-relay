# The Relay Frontend - Environment Configuration Example

# Target backend server for Vite development proxy (defaults to local FastAPI on port 8000)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# Optional custom API base URL (leave empty in local development to use Vite proxy)
VITE_API_BASE_URL=

# Timeout for backend HTTP health and readiness probes in milliseconds
VITE_REQUEST_TIMEOUT_MS=5000

# Timeout for research assistant /v1/ask inference in milliseconds (default: 60000ms = 60s)
VITE_ASK_TIMEOUT_MS=60000

# Periodic health polling interval in milliseconds
VITE_POLL_INTERVAL_MS=15000
